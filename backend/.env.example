# GAN-Sim-GAN Backend Environment Configuration

# Application Settings
APP_NAME=GAN-Sim-GAN
APP_VERSION=1.0.0
DEBUG=True

# Server Settings
HOST=0.0.0.0
PORT=8000

# CORS Settings
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Model Settings
MODEL_PATH=../ml-training/checkpoints/densenet121_best.pth
MODEL_ARCHITECTURE=densenet121
NUM_CLASSES=3
IMAGE_SIZE=224

# Upload Settings
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
ALLOWED_EXTENSIONS=[".jpg", ".jpeg", ".png"]

# Device Settings (auto-detected if not specified)
# DEVICE=cuda  # or 'cpu'

# Logging
LOG_LEVEL=INFO
