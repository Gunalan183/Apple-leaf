ml-training/datasets/Apple/
ml-training/datasets/Apple_Augmented/
ml-training/datasets/original/
*.jpg
*.jpeg
*.png
*.bmp
*.tiff
*.webp

# Keep frontend assets and public images
!frontend/src/assets/*.png
!frontend/src/assets/*.svg
!frontend/public/*.png
!frontend/public/*.svg
!frontend/public/*.ico

# Keep placeholder files to preserve directory structure
!ml-training/datasets/.gitkeep
!ml-training/checkpoints/.gitkeep

